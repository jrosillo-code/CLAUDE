# Rosillo Intake Copilot — synthetic-data prototype
# Copy to .env and fill in. NEVER commit .env.

# Database (ADR-0006). Leave DATABASE_URL empty for local development: the app
# uses PGlite, an embedded Postgres, persisted at DATABASE_PATH — zero setup.
# For Supabase/production, set the transaction-pooler connection string:
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=
DATABASE_PATH=./data/pgdata

# Secret used to sign the synthetic-auth session cookie (any random string in development)
AUTH_SECRET=change-me-in-dev

# AI provider: "mock" (deterministic, default, used by all tests) or "anthropic"
AI_PROVIDER=mock

# Only needed when AI_PROVIDER=anthropic. Server-side only; never exposed to the browser.
ANTHROPIC_API_KEY=

# Model used by the anthropic provider
ANTHROPIC_MODEL=claude-opus-5

# Data classification guard: the app refuses to start if this is not SYNTHETIC
DATA_CLASSIFICATION=SYNTHETIC

# Abuse protection: analyses per user per minute
ANALYSE_RATE_LIMIT=6

# Development only: set to 1 to include message content in structured logs
# LOG_CONTENT=1
