# ── Map tiles (swappable per plan §3) ──
# Any MapLibre style URL. Default is OpenFreeMap positron (no key, no per-load billing).
# For MapTiler: https://api.maptiler.com/maps/dataviz/style.json?key=YOUR_KEY
NEXT_PUBLIC_MAP_STYLE=https://tiles.openfreemap.org/styles/positron

# ── Free data APIs (all optional — the app falls back to keyless services) ──
# Geoapify (https://www.geoapify.com — free tier: 3,000 requests/day, no card).
# One key upgrades BOTH search autocomplete (client) and the route guide's
# hotel/attraction lookups (server). Create a key, paste it here:
NEXT_PUBLIC_GEOAPIFY_KEY=
# Optional server-only override if you want a separate key for the guide:
GEOAPIFY_API_KEY=

# ── AI route guide (Trips → View route) ──
# Server-only. When set, /api/trip-guide asks Claude for a real travel brief on
# every stop (overview, hotels/hostels, activities). Without it you get a
# labeled demo guide. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# ── OAuth buttons on the live login screen ──
# Comma-separated providers you've configured in Supabase → Authentication →
# Providers (each needs its own developer credentials). Unset = email-only.
NEXT_PUBLIC_OAUTH_PROVIDERS=

# ── Supabase (Phase 0 wiring — not required for the seeded demo) ──
# When set, swap lib/store.ts's seed source for the Supabase adapter (see README).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only, never expose to the client:
SUPABASE_SERVICE_ROLE_KEY=
