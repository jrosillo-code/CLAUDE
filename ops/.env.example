# ── Claude (server-only) ──
# Without a key the pipeline runs a deterministic demo extractor so the whole
# flow (intake → validation → tasks → draft → approval → audit) still works.
ANTHROPIC_API_KEY=
# Model for extraction and drafting. Default claude-opus-5.
OPS_MODEL=claude-opus-5

# ── Machine access to the API routes ──
# Bearer token required on /api/* except the provider webhooks below.
OPS_API_KEY=

# ── Supabase (server-only; when unset the app uses an in-memory store) ──
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── WhatsApp Cloud API webhook ──
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=

# ── Inbound email webhook (shared secret sent by your inbound-parse provider) ──
EMAIL_WEBHOOK_SECRET=
