# ── Claude (server-only) ──
# Without a key the pipeline runs a deterministic demo extractor so the whole
# flow (intake → validation → tasks → draft → approval → audit) still works.
ANTHROPIC_API_KEY=
# Model for extraction and drafting. Default claude-opus-5.
OPS_MODEL=claude-opus-5

# ── Machine access to the API routes ──
# Bearer token required on /api/* except the provider webhooks below.
OPS_API_KEY=

# ── Supabase (when unset the app uses an in-memory store) ──
# Project URL: either name works.
NEXT_PUBLIC_SUPABASE_URL=
# Anon key for member sign-in; used server-side only, any of these names works:
ANON_KEY=
# Service role key, server-only, never public:
SUPABASE_SERVICE_ROLE_KEY=

# ── Outbound senders (used only after a human approves; unset = log only) ──
SMTP_URL=
MAIL_FROM=
# Where website contact requests are forwarded (needs SMTP above):
LEADS_TO=
WHATSAPP_PHONE_NUMBER_ID=
# Approved template with one body parameter, used when the 24-hour window is closed:
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=es

# ── Job runner (POST /api/jobs/run from a cron); OPS_API_KEY also works ──
CRON_SECRET=

# ── WhatsApp Cloud API webhook ──
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=

# ── Inbound email webhook (shared secret sent by your inbound-parse provider) ──
EMAIL_WEBHOOK_SECRET=

# Public site URL for sitemap, canonical and OpenGraph (no trailing slash):
NEXT_PUBLIC_SITE_URL=
